# Experiment-only layer: adds EP_MAX_CHANNELS_PER_SM, an env cap on the hybrid
# dispatch channels-per-SM (combine inherits the count from the dispatch handle,
# buffer.hpp:1381-1389). Purpose: hold num_sms=12 fixed and change ONLY the number
# of scale-out messages per op (one put per channel per remote node), to separate
# per-message cost from SM count. Host-side only (compiled into _C.so); the channel
# count reaches the kernel as a JIT parameter, so no stale-cubin risk.
ARG BASE
FROM ${BASE}
RUN set -eux; cd /opt/DeepEP; \
    python3 - <<'PY'
p='csrc/elastic/buffer.hpp'; s=open(p).read()
anchor="            // Reduce the channel count to fit this launch's GIN indexed-signal budget."
assert s.count(anchor)==1, 'anchor not found exactly once'
cap='''            // [experiment] EP_MAX_CHANNELS_PER_SM caps channels/SM (0 = off).
            if (const int cap = get_env<int>("EP_MAX_CHANNELS_PER_SM", 0); cap > 0)
                num_channels_per_sm = std::min<int>(num_channels_per_sm, cap);
'''
s=s.replace(anchor, cap+anchor); open(p,'w').write(s); print('patched')
PY
RUN set -eux; cd /opt/DeepEP; \
    SITE="$(cd / && python3 -c 'import importlib.util,os; print(os.path.dirname(os.path.dirname(importlib.util.find_spec("deep_ep").origin)))')"; echo "site $SITE"; \
    pip uninstall -y deep-ep deep_ep 2>/dev/null || true; \
    rm -rf "$SITE"/deep_ep* ; \
    if [ -f "$SITE/easy-install.pth" ]; then grep -v deep_ep "$SITE/easy-install.pth" > /tmp/pth || true; mv /tmp/pth "$SITE/easy-install.pth"; fi; \
    NCCL_LIB="$(python3 -c 'import nvidia.nccl, os; print(os.path.join(list(nvidia.nccl.__path__)[0], "lib"))')"; \
    LIBRARY_PATH="$NCCL_LIB:/usr/local/cuda/lib64/stubs" python3 setup.py install; rm -rf build; \
    PKG="$(cd / && python3 -c 'import importlib.util,os; print(os.path.dirname(importlib.util.find_spec("deep_ep").origin))')"; \
    SO="$(find "$PKG" -maxdepth 1 -name '_C*.so' | head -1)"; strings "$SO" | grep -q EP_MAX_CHANNELS_PER_SM; \
    echo "chcap" >> /opt/DeepEP/BUILD_REF_PARENTS
